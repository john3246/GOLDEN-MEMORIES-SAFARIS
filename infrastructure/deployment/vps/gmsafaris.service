# /etc/systemd/system/gmsafaris.service
[Unit]
Description=GM Safaris website, CMS and API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=gmsafaris
WorkingDirectory=/opt/gmsafaris
EnvironmentFile=/opt/gmsafaris/.env
Environment=SERVE_PUBLIC=true
Environment=NODE_OPTIONS=--max-old-space-size=512
ExecStart=/usr/bin/node scripts/start-render.mjs
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/gmsafaris

[Install]
WantedBy=multi-user.target
