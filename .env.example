# =============================================================================
# GM Safaris — Environment Configuration Template
# Copy to .env and fill in real values. Never commit .env.
# On Render / any host, set the same names in the service's Environment tab.
# =============================================================================

NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# --- PostgreSQL (ALL CMS content, users, bookings and photos are stored here) ---
# Local: run `npm run db:setup` once. Render: use the "Internal Database URL" parts.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=gm_safaris
DATABASE_USER=gm_safaris_app
DATABASE_PASSWORD=change_me_strong_password
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
# Apply new database/migrations automatically when the API starts.
DATABASE_AUTO_MIGRATE=true
# auto = PostgreSQL when reachable (recommended) · postgres = refuse to start without it · file = legacy store.json
CMS_STORE=auto

# --- Redis (optional cache only — never source of truth) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=gm:safaris:
REDIS_TTL_SECONDS=300

# --- CMS sessions & encryption ---
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=false
# Encrypts SMTP password, webhook secrets and review API keys saved from the CMS. Never change it once set.
APP_ENCRYPTION_KEY=

# --- External API (read-only consumer credentials for gmsafaris.co.tz) ---
# Prefer keys issued in CMS → API keys. This list is a fallback.
EXTERNAL_API_KEYS=
EXTERNAL_API_RATE_LIMIT_WINDOW_MS=60000
EXTERNAL_API_RATE_LIMIT_MAX=120

# --- Rate limits (ms / max requests) ---
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=600
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=600
# Contact / booking forms per visitor per 10 minutes
RATE_LIMIT_FORMS_MAX=8

# --- Domains ---
# Main website and the canonical address Google should index.
SITE_URL_COM=https://www.gmsafaris.com
SITE_URL_COTZ=https://www.gmsafaris.co.tz
# Production only: redirect http:// and gmsafaris.com → https://www.gmsafaris.com
CANONICAL_HOST=
# Browser origins allowed to call the API (comma-separated; never use *)
CORS_ORIGINS_CMS=http://localhost:5173,https://www.gmsafaris.com,https://gmsafaris.com
CORS_ORIGINS_WEBSITE=http://localhost:4173,https://www.gmsafaris.com,https://gmsafaris.com
CORS_ORIGINS_EXTERNAL=https://www.gmsafaris.co.tz,https://gmsafaris.co.tz

# When true, the API also serves the built website (apps/website-com/dist) and the CMS at /cms/.
# `npm run local` and `npm start` switch this on for you.
SERVE_PUBLIC=false

# --- CMS first-run owner account (used ONLY when the database has no users yet) ---
# After the first sign-in, change the password in CMS → My profile.
CMS_ADMIN_EMAIL=info@gmsafaris.com
CMS_ADMIN_PASSWORD=Choose-A-Strong-Passw0rd!
CMS_DATA_DIR=./data/cms
CMS_SEED_SAFARIS=true

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json

# --- Media uploads ---
# Files are cached here and ALSO stored in PostgreSQL, so they survive redeploys.
MEDIA_UPLOAD_DIR=./uploads
MEDIA_MAX_FILE_SIZE_MB=10
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif

# --- Outgoing email (booking confirmations, inquiry replies, reminders, password resets) ---
# Google Workspace / Gmail: create an App Password (Google Account → Security → App passwords)
# and use it here — not the normal mailbox password.
# Port 587 = STARTTLS (SMTP_SECURE=false). Port 465 = SSL (SMTP_SECURE=true).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_FROM_NAME=Golden Memories Safaris
SMTP_FROM_EMAIL=
# true = log emails instead of sending them (handy when testing locally)
SMTP_DRY_RUN=false

# --- Optional: extra Content-Security-Policy sources (space or comma separated) ---
CSP_CONNECT_SRC=
CSP_FRAME_SRC=
CSP_SCRIPT_SRC=
