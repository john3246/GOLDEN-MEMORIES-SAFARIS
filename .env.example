# =============================================================================
# GM Safaris — Environment Configuration Template
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# --- PostgreSQL (Phase 2 schema: database/migrations) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=gm_safaris
DATABASE_USER=gm_safaris_app
DATABASE_PASSWORD=change_me_strong_password
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# --- Redis (cache only — never source of truth) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=gm:safaris:
REDIS_TTL_SECONDS=300

# --- CMS / internal auth ---
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=false

# --- External API (read-only consumer credentials for .co.tz) ---
# Generate a strong key; store hashed in DB in later phases. For Phase 1 scaffolding only.
EXTERNAL_API_KEYS=
EXTERNAL_API_RATE_LIMIT_WINDOW_MS=60000
EXTERNAL_API_RATE_LIMIT_MAX=120

# --- Rate limits (ms / max requests) ---
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=200

# --- CORS (comma-separated origins; never use * for admin APIs) ---
CORS_ORIGINS_CMS=http://localhost:5173,https://www.gmsafaris.com,https://gmsafaris.com
CORS_ORIGINS_WEBSITE=http://localhost:4173,http://localhost:4174,http://localhost:4175,https://www.gmsafaris.com,https://gmsafaris.com
CORS_ORIGINS_EXTERNAL=https://www.gmsafaris.co.tz,https://gmsafaris.co.tz

# When true, the API also serves apps/website-com/dist (site + /cms/).
# On Render this defaults to true (RENDER=true). Local default is false.
SERVE_PUBLIC=false

# --- Safari CMS (file-backed content store; independent of bookings DB) ---
CMS_DATA_DIR=./data/cms
CMS_SEED_SAFARIS=true
CMS_ADMIN_EMAIL=info@gms.co.tz
CMS_ADMIN_PASSWORD=1234gms
CMS_EDITOR_EMAIL=editor@gmsafaris.com
CMS_EDITOR_PASSWORD=ChangeMeEditor!23
CMS_VIEWER_EMAIL=viewer@gmsafaris.com
CMS_VIEWER_PASSWORD=ChangeMeViewer!23

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json

# --- Media (paths relative to process or absolute) ---
MEDIA_UPLOAD_DIR=./uploads
MEDIA_MAX_FILE_SIZE_MB=10
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif

# --- Public site URLs (environment-specific) ---
SITE_URL_COM=https://www.gmsafaris.com
SITE_URL_COTZ=https://www.gmsafaris.co.tz

# --- Outbound email (never put a real password in this file) ---
# Port 587 uses STARTTLS. Port 465 uses implicit SSL (set SMTP_SECURE=true).
# For Gmail, use an App Password (not the mailbox login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_FROM_NAME=Golden Memories Safaris
SMTP_FROM_EMAIL=
